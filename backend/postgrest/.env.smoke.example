# Daqiq ERP local smoke-test environment example.
# Copy this file to backend/postgrest/.env.smoke.ps1 for repeatable local runs,
# or copy the lines into your current PowerShell session.
# check-dev-health.ps1 and run-all-smoke-tests.ps1 auto-load .env.smoke.ps1 when it exists.
# Never commit real passwords, JWTs, refresh tokens, or secrets.

$env:PGRST_BASE_URL = "http://127.0.0.1:3500"

$env:SMOKE_ADMIN_EMAIL = "admin@example.local"
$env:SMOKE_ADMIN_PASSWORD = "<local-dev-password>"

$env:SMOKE_ACCOUNTANT_EMAIL = "accountant@example.local"
$env:SMOKE_ACCOUNTANT_PASSWORD = "<local-dev-password>"

$env:SMOKE_MANAGER_EMAIL = "manager@example.local"
$env:SMOKE_MANAGER_PASSWORD = "<local-dev-password>"

$env:SMOKE_WAREHOUSE_EMAIL = "warehouse@example.local"
$env:SMOKE_WAREHOUSE_PASSWORD = "<local-dev-password>"

$env:SMOKE_SALES_EMAIL = "sales@example.local"
$env:SMOKE_SALES_PASSWORD = "<local-dev-password>"

$env:SMOKE_VIEWER_EMAIL = "viewer@example.local"
$env:SMOKE_VIEWER_PASSWORD = "<local-dev-password>"
