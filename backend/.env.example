# Local development only. Copy to backend/.env and replace every placeholder.
# Do not use these values for production.

POSTGRES_DB=daqiq_erp_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-admin-password
POSTGRES_PORT=5432

# Password assigned to the PostgREST authenticator role during first local DB initialization.
PGRST_DB_AUTHENTICATOR_PASSWORD=replace-with-local-authenticator-password

# Use a strong secret from a local secret manager. Minimum 32 bytes for symmetric JWT verification.
# The same value is used by PostgREST for verification and PostgreSQL app.jwt_secret for signing.
PGRST_JWT_SECRET=replace-with-at-least-32-byte-local-dev-secret

POSTGREST_PORT=3000
PGRST_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Set true only for local development databases.
POSTGRES_APPLY_DEV_SEEDS=true
