# Daqiq ERP local browser-demo environment example.
# Copy this file to e2e/.env.e2e.ps1 for repeatable local browser smoke runs,
# or copy the lines into your current PowerShell session.
# Never commit real passwords, JWTs, refresh tokens, or secrets.

$env:ERP_APP_BASE_URL = "http://localhost:4200"
$env:PGRST_BASE_URL = "http://127.0.0.1:3500"

$env:SMOKE_ADMIN_EMAIL = "admin@example.local"
$env:SMOKE_ADMIN_PASSWORD = "<local-dev-password>"

$env:SMOKE_VIEWER_EMAIL = "viewer@example.local"
$env:SMOKE_VIEWER_PASSWORD = "<local-dev-password>"

# Optional: use a locally installed Chrome channel. Defaults to chrome.
$env:PLAYWRIGHT_BROWSER_CHANNEL = "chrome"
