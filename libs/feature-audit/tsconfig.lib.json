{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "paths": {
      "@daqiq/core": [
        "dist/core"
      ],
      "@daqiq/ui": [
        "dist/ui"
      ]
    },
    "types": []
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/test-setup.ts"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
